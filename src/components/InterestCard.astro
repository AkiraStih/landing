---
import { Icon } from 'astro-icon/components';
import type { IconName } from '../type/icon';

interface Props {
  icon: IconName;
  title: string;
  text: string;
}
const { title, text,icon } = Astro.props;
---

<div class="flex flex-col">
  <div class="flex items-center gap-2 md:gap-4">
    <Icon class="max-w-[44px] md:max-w-[60px]" name={icon} size='60' />
    <div>
      <h4 class="subtitle">{title}</h4>
      <p class="body mt-1">{text}</p>
    </div>
  </div>
</div>
