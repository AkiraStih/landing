---
import Logo from '../assets/logo.svg';
---

<header
  class="bg-surface border-border-light sticky top-0 flex w-full justify-between border-b-2 px-14 py-3.5"
>
  <Logo />
  <!-- Десктоп-меню -->
  <nav
    class="text-muted hidden text-base font-semibold md:flex md:items-center md:gap-3.5"
  >
    <a href="/" class="hover:text-primary">Main</a>
    <a href="/about" class="hover:text-primary">About</a>
    <a href="/get-in-touch" class="hover:text-primary">Get in touch</a>
  </nav>

  <!-- Кнопка-бургер, только мобилка -->
  <button
    id="burger"
    aria-label="Открыть меню"
    aria-expanded="false"
    class="hover:text-primary md:hidden"
  >
    <svg
      id="icon-burger"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <svg
      id="icon-close"
      class="hidden h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <!-- Мобильное меню -->
  <nav
    id="mobile-menu"
    class="border-border-light absolute top-4/5 left-0 hidden w-full flex-col gap-1 border-t-2 bg-white px-6 py-4 md:hidden"
  >
    <a href="/" class="text-muted hover:text-primary rounded-lg px-3 py-2 text-sm"
      >Главная</a
    >
    <a href="/about" class="text-muted hover:text-primary rounded-lg px-3 py-2 text-sm"
      >О нас</a
    >
    <a href="/contact" class="text-muted hover:text-primary rounded-lg px-3 py-2 text-sm"
      >Контакты</a
    >
  </nav>
</header>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  const iconBurger = document.getElementById('icon-burger');
  const iconClose = document.getElementById('icon-close');

  burger?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');

    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconBurger?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    burger.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
