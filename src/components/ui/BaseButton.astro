---
import Send from '@assets/send.svg';
const { class: className, ...rest } = Astro.props;
---

<button
  class:list={[
    'bg-primary stroke-primary flex gap-3 rounded-3xl fill-white px-6.5 py-3.5 text-base font-semibold text-white transition-colors hover:bg-violet-700 active:outline-4 active:outline-purple-300',
    className,
  ]}
  {...rest}
>
  <slot />
  <Send />
</button>
