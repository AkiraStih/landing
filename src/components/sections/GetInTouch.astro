---
import Person from '@assets/person.svg';
import Error from '@assets/error.svg';
import BaseButton from '@components/ui/BaseButton.astro';
---

<section class="bg-[url(/bg.png)] px-64.5 py-18">
  <div class="flex flex-col gap-12 rounded-2xl bg-white p-12">
    <h2>Let’s discuss your project</h2>
    <div class="flex gap-5">
      <div class="relative flex flex-1 flex-col gap-1.5">
        <label for="name" class="subtitle-2">Your full name</label>
        <Person class="text-muted absolute top-1/2 translate-x-5 translate-y-1/9" />
        <input
          id="name"
          type="text"
          placeholder="Name Surname"
          class="body focus:border-primary w-full rounded-xl border border-gray-300 px-12.5 py-3.5 outline-none focus:ring-2 focus:ring-purple-200"
        />
      </div>
      <div class="relative flex flex-1 flex-col gap-1.5">
        <label for="email" class="subtitle-2">Your email</label>
        <Error class="text-error absolute top-1/2 translate-x-5 translate-y-1/9" />
        <input
          id="email"
          type="email"
          placeholder="name@example.com"
          class="body border-error focus:border-primary w-full rounded-xl border px-12.5 py-3.5 outline-none focus:ring-2 focus:ring-purple-200"
        />
      </div>
    </div>
    <div class="relative flex flex-col gap-1.5">
      <label for="name" class="subtitle-2">Tell me about your project</label>
      <textarea
        rows="5"
        placeholder="Add here a general description of your idea and target aim"
        class="body w-full resize-none rounded-xl border border-gray-200 p-4 outline-none focus:border-purple-400"
      ></textarea>
    </div>
    <BaseButton class="max-w-36.75">Submit</BaseButton>
  </div>
</section>
