---
import BaseButton from '@components/ui/BaseButton.astro';
import InterestCard from '@components/InterestCard.astro';
import EducationComponent from '@components/EducationComponent.astro';
---

<section class="h-screen">
  <h2 class="mt-25 ml-21">About me</h2>
  <div class="mt-20 flex items-center gap-40 px-20">
    <img src="about.png" alt="" />
    <div class="max-w-110">
      <div class="bg-primary j h-1 w-7"></div>
      <p class="text-muted mt-6 text-xl">
        <span class="text-main text-xl font-semibold"> Nick Richardson </span> - specialist
        in Frontend development. Clear code is my passion. Solving issues through negotiations
      </p>
      <BaseButton class="mt-14">Get in touch</BaseButton>
    </div>
  </div>
  <div class="mt-20 flex justify-between px-22">
    <div>
      <h3>Interest</h3>
      <div class="mt-11 flex flex-col gap-11">
        <InterestCard icon="music" title="Music" text="Indie rock | Reggae" />
        <InterestCard icon="art" title="Art" text="Edvard Munch | Frida Kahlo" />
        <InterestCard icon="photography" title="Photography" text="Portraits" />
      </div>
    </div>

    <div>
      <h3>Education & Experience</h3>
      <div class="flex flex-col gap-6 pt-11">
        <EducationComponent
          role="Middle Frontend developer"
          period="2008 - Present"
          organization="Ozon"
        />
        <EducationComponent
          role="Frontend development courses"
          period="2006 - 2007"
          organization="Stepik"
        />
        <EducationComponent
          role="Frontend developer"
          period="2000 - 2005"
          organization="Saint Petersburg State University"
        />
      </div>
    </div>
  </div>
</section>
