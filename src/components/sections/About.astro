---
import BaseButton from '@components/ui/BaseButton.astro';
import InterestCard from '@components/InterestCard.astro';
import EducationComponent from '@components/EducationComponent.astro';
---

<section class="min-h-screen">
  <h2 class="mt-12 ml-4 md:mt-25 md:ml-10 lg:ml-21">About me</h2>
  <div
    class="mt-9 flex flex-col gap-9 px-4 md:mt-20 md:flex-row md:items-center md:gap-10 md:px-20 lg:gap-40"
  >
    <img class="md:w-[290px] lg:w-[412px]" src="about.png" alt="" />
    <div class="max-w-110">
      <div class="bg-primary j h-1 w-7"></div>
      <p class="text-muted mt-6 text-sm md:text-xl">
        <span class="text-main text-sm font-semibold md:text-xl"> Nick Richardson </span> -
        specialist in Frontend development. Clear code is my passion. Solving issues through
        negotiations
      </p>
      <BaseButton class="mt-14 hidden md:flex">Get in touch</BaseButton>
    </div>
  </div>
  <div class="mt-20 flex flex-col gap-20 px-4 md:px-22 lg:flex-row lg:justify-between">
    <div>
      <h3 class="lg:2xl text-xl">Interest</h3>
      <div class="mt-11 flex flex-col gap-11">
        <InterestCard icon="music" title="Music" text="Indie rock | Reggae" />
        <InterestCard icon="art" title="Art" text="Edvard Munch | Frida Kahlo" />
        <InterestCard icon="photography" title="Photography" text="Portraits" />
      </div>
    </div>

    <div>
      <h3 class="lg:2xl text-xl">Education & Experience</h3>
      <div class="flex flex-col gap-6 pt-11">
        <EducationComponent
          role="Middle Frontend developer"
          period="2008 - Present"
          organization="Ozon"
        />
        <EducationComponent
          role="Frontend development courses"
          period="2006 - 2007"
          organization="Stepik"
        />
        <EducationComponent
          role="Frontend developer"
          period="2000 - 2005"
          organization="Saint Petersburg State University"
        />
      </div>
      <BaseButton class="mt-12 mb-23 md:hidden">Get in touch</BaseButton>
    </div>
  </div>
</section>
