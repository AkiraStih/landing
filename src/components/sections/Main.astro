---
import BaseButton from '@components/ui/BaseButton.astro';
---

<main class="relative h-[calc(100vh-63.6px)] overflow-hidden">
  <picture>
    <source media="(max-width: 767px)" srcset="/background-mobile.png" />
    <source media="(max-width: 1023px)" srcset="/background-tablet.png" />
    <img class="absolute right-0 bottom-0" src="/background.png" alt="" />
  </picture>

  <picture>
    <source media="(max-width: 767px)" srcset="/man-mobile.png" />
    <source media="(max-width: 1023px)" srcset="/man-tablet.png" />
    <img class="absolute right-0 bottom-0" src="/man.png" alt="" />
  </picture>

  <div class="h-full items-center px-4 py-7 md:flex md:px-11 lg:items-center lg:px-16">
    <div class="max-w-md">
      <h1 class="text-2xl font-bold md:text-5xl">Hey, I'm Nick</h1>
      <p class="text-muted mt-4 text-xl">Frontend developer</p>
      <div class="bg-primary mt-9 h-1 w-7 md:mt-9 lg:mt-24"></div>
      <p class="text-muted mt-6 text-sm lg:text-xl">
        Help you to create high-quality digital products that your clients will love and
        let your business thrive
      </p>

      <BaseButton class="mt-14">Get in touch</BaseButton>
    </div>
  </div>
</main>
